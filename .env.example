# ── AI Gateway ────────────────────────────────────────────────────────────────
GATEWAY_URL=http://localhost:4242
GATEWAY_PROVIDERS=anthropic
CLAUDE_MODEL=claude-sonnet-4-6

# ── Bot identity ──────────────────────────────────────────────────────────────
BOT_NAME=Claude

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_OWNER_ID=your_discord_user_id   # snowflake ID — receives health alerts

# ── Slack (optional) ──────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# ── Telegram (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── WhatsApp (optional) ───────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ── WeChat (optional) ─────────────────────────────────────────────────────────
WECHATY_PUPPET=wechaty-puppet-wechat4u
WECHATY_TOKEN=your_wechaty_puppet_service_token

# ── Paths ─────────────────────────────────────────────────────────────────────
# CLAUDE_SKILLS_DIR=/home/yourname/.claude/skills   # default: ~/.claude/skills
# DB_PATH=./data/claudebot.db                        # default: ./data/claudebot.db

# ── Observability ─────────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
# PROMETHEUS_PORT=9464
